        </mxCell>
        <mxCell id="t3-m3" value="两段式判死：Nacos 线索 +&#xa;/internal/health 确证" style="edgeStyle=none;html=0;strokeWidth=2;strokeColor=#DC2626;endArrow=block;dashed=1;fontFamily=system-ui, -apple-system, PingFang SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#DC2626;labelBackgroundColor=#F8FAFC;" edge="1" parent="1">
